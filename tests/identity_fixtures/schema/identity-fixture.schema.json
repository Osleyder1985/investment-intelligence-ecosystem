{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iim:identity-fixture:schema:0.1.0",
  "title": "IIM identity conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "fixture_version",
    "fixture_kind",
    "purpose",
    "requirement_ids",
    "case_ids",
    "profile_id",
    "profile_version",
    "input",
    "expected_result",
    "provenance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^FX-[A-Z0-9-]+$"
    },
    "fixture_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fixture_kind": {
      "enum": [
        "SYNTHETIC",
        "CAPTURED",
        "REDACTED_CAPTURE"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IIM-[0-9]{3}$"
      }
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AS-[0-9]{3}$"
      }
    },
    "profile_id": {
      "enum": [
        "EVM",
        "SOLANA"
      ]
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "required": [
        "network_context",
        "observations"
      ],
      "properties": {
        "network_context": {
          "type": "object",
          "required": [
            "family",
            "network_id_fixture"
          ],
          "properties": {
            "family": {
              "enum": [
                "EVM",
                "SOLANA"
              ]
            },
            "network_id_fixture": {
              "type": "string",
              "minLength": 1
            },
            "chain_id": {
              "type": "string"
            },
            "genesis_hash": {
              "type": "string"
            },
            "cluster_label": {
              "type": "string"
            },
            "checkpoint": {
              "type": "object",
              "required": [
                "height_or_slot",
                "block_or_state_hash"
              ],
              "properties": {
                "height_or_slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "block_or_state_hash": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "entity_type",
              "raw_identifier",
              "encoding",
              "normalized_identifier",
              "normalization_method",
              "observation_ref"
            ],
            "properties": {
              "entity_type": {
                "const": "asset_representation"
              },
              "raw_identifier": {
                "type": "string",
                "minLength": 1
              },
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "normalized_identifier": {
                "type": "string",
                "minLength": 1
              },
              "normalization_method": {
                "type": "string",
                "minLength": 1
              },
              "observation_ref": {
                "type": "string",
                "minLength": 1
              },
              "contract_state": {
                "type": "object",
                "properties": {
                  "code_present": {
                    "type": "boolean"
                  },
                  "code_hash": {
                    "type": "string"
                  },
                  "token_interface_check": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              },
              "mint_account": {
                "type": "object",
                "properties": {
                  "exists": {
                    "type": "boolean"
                  },
                  "initialized": {
                    "type": "boolean"
                  },
                  "owner_program_id": {
                    "type": "string"
                  },
                  "token_program": {
                    "enum": [
                      "TOKEN_PROGRAM",
                      "TOKEN_2022"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "expected_result": {
      "type": "object",
      "required": [
        "resolution_status",
        "entity_candidates",
        "assertions",
        "abstention_scope"
      ],
      "properties": {
        "resolution_status": {
          "enum": [
            "RESOLVED",
            "RESOLVED_WITH_LIMITATIONS",
            "AMBIGUOUS",
            "UNVERIFIED",
            "CONFLICTED",
            "RETIRED_OR_MIGRATED"
          ]
        },
        "entity_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_fixture_id",
              "entity_type",
              "key"
            ],
            "properties": {
              "entity_fixture_id": {
                "type": "string",
                "minLength": 1
              },
              "entity_type": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "selected_entity_fixture_id": {
          "type": "string"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abstention_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "synthetic",
        "source",
        "permission_record"
      ],
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "object",
            "null"
          ]
        },
        "permission_record": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "const": "SYNTHETIC"
          }
        },
        "required": [
          "fixture_kind"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "synthetic": {
                "const": true
              },
              "source": {
                "type": "null"
              },
              "permission_record": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "enum": [
              "CAPTURED",
              "REDACTED_CAPTURE"
            ]
          }
        },
        "required": [
          "fixture_kind"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "synthetic": {
                "const": false
              },
              "source": {
                "type": "object"
              },
              "permission_record": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_id": {
            "const": "EVM"
          }
        },
        "required": [
          "profile_id"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "properties": {
              "network_context": {
                "properties": {
                  "family": {
                    "const": "EVM"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_id": {
            "const": "SOLANA"
          }
        },
        "required": [
          "profile_id"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "properties": {
              "network_context": {
                "properties": {
                  "family": {
                    "const": "SOLANA"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
